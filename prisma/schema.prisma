generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum AuditAction {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  PRODUCT_REACTIVATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  IMAGE_UPLOADED
  IMAGE_DELETED
  COLOR_CREATED
  COLOR_UPDATED
  COLOR_DEACTIVATED
  COLOR_DELETED
  SITE_CONTENT_UPDATED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProducts Product[] @relation("CreatedProducts")
  updatedProducts Product[] @relation("UpdatedProducts")
  deletedProducts Product[] @relation("DeletedProducts")
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
}

model Product {
  id               String   @id @default(cuid())
  legacyId         Int?     @unique
  slug             String   @unique
  nombre           String
  categoria        String
  precio           Int
  imagen           String?
  imagenesPorColor Json?
  descripcion      String
  disponible       Boolean  @default(true)
  destacado        Boolean  @default(false)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  createdById String?
  updatedById String?
  deletedById String?
  createdBy   User? @relation("CreatedProducts", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User? @relation("UpdatedProducts", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy   User? @relation("DeletedProducts", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([activo, disponible, destacado])
  @@index([categoria])
  @@index([deletedAt])
}


model Color {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  hex       String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

model SiteContent {
  id                      String   @id @default("home")
  promoEnabled            Boolean  @default(true)
  promoText               String   @default("LLEVANDO 3 PRODUCTOS TENÉS 5% DE DESCUENTO")
  promoHref               String?
  heroEyebrow             String   @default("Tienda temática · Buenos Aires")
  heroTitlePrefix         String   @default("Remeras con")
  heroTitleAccent         String   @default("estilo")
  heroTitleSuffix         String   @default("nostalgia y personalidad")
  heroText                String   @default("En Retro Remeras mezclamos cultura pop, estética vintage y diseños con identidad. Elegí una categoría, encontrá tu estilo y armá tu pedido desde la página de cada producto.")
  heroPrimaryButtonText   String   @default("Ver catálogo")
  heroPrimaryButtonHref   String   @default("/catalogo")
  heroSecondaryButtonText String   @default("Ver carrito")
  heroSecondaryButtonHref String   @default("/carrito")
  heroMainImage           String   @default("/assets/img/ejemplo-vintage.jpg")
  heroMainImageAlt        String   @default("Diseño vintage destacado")
  heroBadgeText           String   @default("Colecciones con impronta retro")
  heroSideImageOne        String   @default("/assets/img/remera-goku.jpg")
  heroSideImageOneAlt     String   @default("Diseño anime destacado")
  heroSideImageTwo        String   @default("/assets/img/ejemplo-gaming.jpg")
  heroSideImageTwoAlt     String   @default("Diseño videojuegos destacado")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model RefreshToken {
  id         String    @id @default(cuid())
  jti        String    @unique
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String
  entityId  String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
